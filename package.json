  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "prettier": "^3.9.9",
    "supabase": "^2.119.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "pitch": "node scripts/pitch.mjs",
    "pitch:web": "node scripts/pitch.mjs --web",
    "pitch:export": "node scripts/pitch-export.mjs",
    "preflight": "node scripts/preflight.mjs",
    "perf:db": "vitest run --config vitest.perf.config.mts",
    "lint": "eslint .",
    "typecheck": "node --max-old-space-size=4096 node_modules/typescript/bin/tsc --noEmit",
    "test": "vitest run && jest",
    "test:db": "vitest run tests/integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "brand:export": "tsx scripts/export-brand.ts",
    "test:unit": "vitest run tests/unit",
    "test:components": "jest",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/services/supabase/database.generated.ts"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
