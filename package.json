    "expo": "~57.0.27",
    "expo-apple-authentication": "~57.0.2",
    "expo-asset": "~57.0.19",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
