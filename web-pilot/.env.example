# Dynorex pilot MVP: environment variable names only. Never commit real values.

# Folder for the local-mode JSON database and uploaded files. Default: ./.data
# Local mode is for pilots on one machine. It is not a production database.
DYNOREX_DATA_DIR=

# Set to "true" only if you deliberately want signups on a deployed instance.
# Local-mode accounts are NOT production authentication.
DYNOREX_ALLOW_SIGNUP=true

# Public base URL used when building share links shown to the owner (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email is NOT sent by this MVP. Pilot-interest submissions are stored locally only.
# No email provider variables are read.
