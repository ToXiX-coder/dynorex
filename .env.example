# Dynorex app environment. Names and descriptions only. Copy to .env.local for local work.
# EXPO_PUBLIC_* values are compiled INTO the app and are PUBLIC. Never put a secret in one.

# development | staging | production. Picks bundle IDs and app name (see app.config.ts).
APP_ENV=development

# Supabase project URL and anon (publishable) key. Public by design: row-level security protects data.
# Local: printed by `npx supabase start`.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Sentry DSN (public). Leave empty to disable error reporting.
EXPO_PUBLIC_SENTRY_DSN=

# Mapbox PUBLIC access token (starts with "pk."), used by Line (v2). Restrict it to the app's
# bundle IDs / URLs in the Mapbox account. Secret "sk." tokens are rejected by the app.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Development-only feature flag overrides, e.g. "line=true". Ignored in production builds.
EXPO_PUBLIC_FLAG_OVERRIDES=

# ---------------------------------------------------------------------------------------------
# SERVER-ONLY secrets. These never go in this file, the app, or the repository:
#   SUPABASE_SERVICE_ROLE_KEY   -> Supabase Edge Function secrets (auto-provided by Supabase)
#   SUPABASE_ACCESS_TOKEN, SUPABASE_DB_PASSWORD -> GitHub Actions secrets (deploy jobs only)
#   SENTRY_AUTH_TOKEN           -> EAS secrets (source map upload at build time)
#   EXPO_TOKEN                  -> GitHub Actions secret (EAS preview builds)
#   STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET -> Edge Function secrets (v2 marketplace only)
#   MAPBOX_SECRET_TOKEN (sk.)  -> Edge Function secrets, only if server-side Mapbox APIs are used (v2)
#   APPLE / GOOGLE store server credentials  -> Edge Function secrets (Phase 5 receipt validation)
#   PUSH_DISPATCH_SECRET        -> Edge Function secret + the scheduler job that calls push-dispatch
#   EXPO_ACCESS_TOKEN           -> Edge Function secret, optional (Expo "enhanced push security")

# Optional store links for the "Get the app" banner on dynorex.app pages. Leave empty until the
# store listings exist; the banner is not shown without them.
EXPO_PUBLIC_APP_STORE_URL=
EXPO_PUBLIC_PLAY_STORE_URL=

# EAS project ID (public). Needed for push tokens; set by `eas init`.
EXPO_PUBLIC_EAS_PROJECT_ID=

# RevenueCat PUBLIC SDK keys (Dynorex+ purchases). Safe in the app; leave empty until the stores and
# RevenueCat project exist (the paywall then says purchases aren't available).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# SERVER-ONLY (Edge Function secrets): REVENUECAT_SECRET_KEY, REVENUECAT_WEBHOOK_AUTH,
# ALLOW_SANDBOX_PURCHASES (staging only).

# Pitch mode: "true" runs the app with no sign-in on an in-memory sample-data backend, with a
# permanent PITCH MODE banner. Development/staging only; production builds ignore it.
EXPO_PUBLIC_DEMO_MODE=
